# ============================================================
# PHONEX — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Supabase (required) ─────────────────────────────────
# Found at: https://supabase.com/dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# ─── Edge Functions secrets (set via Supabase CLI) ────────
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=xxx
# supabase secrets set WEBHOOK_SECRET=xxx
# supabase secrets set RESEND_API_KEY=xxx

# These are NOT prefixed with VITE_ and are never exposed to the browser.
# Set them with: supabase secrets set KEY=value

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Keep this SECRET
WEBHOOK_SECRET=your-random-webhook-secret          # For shipping webhooks

# ─── Email (optional — via Resend) ───────────────────────
# Sign up at https://resend.com and add your domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── App config (optional) ───────────────────────────────
VITE_APP_NAME=PHONEX
VITE_APP_URL=https://phonex.store
VITE_CURRENCY=USD
